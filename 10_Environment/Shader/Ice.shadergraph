{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "836e53699c7d4011addb6b9de2f43efe",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Fresnel (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2053.0,
            "y": -272.9998779296875,
            "width": 259.0003662109375,
            "height": 165.99996948242188
        }
    },
    "m_Slots": [
        {
            "m_Id": "621d706852a347b5b5976a15f314a428"
        },
        {
            "m_Id": "e01b7b22a9154bae862e764bed343859"
        },
        {
            "m_Id": "34d9cf50dbb24c5d9d5cf369cd8e5745"
        },
        {
            "m_Id": "ea6cdaee8aeb42c1b5dbb6c71e622ed0"
        },
        {
            "m_Id": "2b8f57bb8cf34ae4826e9ad2fb7c5ced"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Fresnel",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 N = normalize(normal);\r\nfloat3 V = normalize(viewDir);\n\n\nfloat dotNV = saturate(dot(N, V));\n\rfloat fresnelRaw = pow(1.0 - dotNV, exponent);\nfloat fresnel = lerp(baseReflectFraction, 1.0, fresnelRaw);\nfresnelOut = saturate(fresnel);"
}

